# Copie para .env (desenvolvimento) ou cole no Environment do App no Easypanel.
# ATENÇÃO no Easypanel: cole SEM espaços no começo das linhas.

# Postgres. Senha com caracteres especiais vai codificada (! = %21, @ = %40, # = %23).
DATABASE_URL=postgres://postgres:SENHA@PROJETO_postgres:5432/simulados

# 48+ caracteres aleatórios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Token das rotas /api/admin/* (outro valor aleatório longo)
ADMIN_TOKEN=

NODE_ENV=production
PORT=3000

# Opcionais
# ITENS_STATUS=aprovada              # quais status de questão entram nos simulados (homologação: aprovada,extraida)
# MIDIA_DIR=/app/midia               # pasta das imagens das questões (montar volume)
# IMG_HOSTS=https://academiadepolicia.com.br   # domínios de imagem liberados no CSP (separados por espaço)
# PGSSL=true                         # só se o Postgres exigir SSL
